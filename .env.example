# ============================================================================
# ClauseGraph Production Environment Variables (Pure PostgreSQL 16+)
# ============================================================================

# --- Database Connection (PostgreSQL 16+) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clausegraph"

# --- Authentication & Session Security (JWT) ---
# Required in production: must be a strong secret of at least 32 characters
JWT_SECRET="replace-with-at-least-32-character-random-secret"

# --- Direct AI Provider Keys (Native OpenAI & Google Gemini) ---
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="AIzaSy..."
# Optional: Self-hosted / Azure OpenAI / vLLM endpoint
# OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Optional: Paddle Billing (Sandbox / Live) ---
# Only needed when BILLING_ENABLED = true in src/lib/plans.ts
PADDLE_SANDBOX_API_KEY=""
PADDLE_LIVE_API_KEY=""
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""
PAYMENTS_LIVE_WEBHOOK_SECRET=""
VITE_PAYMENTS_CLIENT_TOKEN=""
